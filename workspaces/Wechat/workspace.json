{
  "description": "WeChat for Linux，基于 RICwang/docker-wechat 项目，适用于 Kasm Workspaces 的微信桌面客户端。",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "wechat.png",
  "categories": [
    "Communication",
    "Social"
  ],
  "friendly_name": "WeChat (微信)",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "ricwang/wechat:latest",
      "uncompressed_size_mb": 800,
      "available_tags": [
        "latest"
      ]
    },
    {
      "version": "1.17.x",
      "image": "ricwang/wechat:latest",
      "uncompressed_size_mb": 800,
      "available_tags": [
        "latest"
      ]
    }
  ],
  "run_config": {
    "env": {
      "LANG": "zh_CN.UTF-8",
      "USER_ID": "0",
      "GROUP_ID": "0",
      "WEB_AUDIO": "1",
      "TZ": "Asia/Shanghai"
    },
    "privileged": true
  },
  "notes": "本工作区基于 ricwang/docker-wechat，已设置中文环境、音频支持和时区。如需持久化数据，请参考官方文档自行挂载目录。"
}
